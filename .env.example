# Configura una contraseña nueva. Usa al menos 12 caracteres con mayúsculas,
# minúsculas, números y símbolos como ! o _. Conserva las comillas simples
# de .env y evita comillas dentro de la contraseña.
MSSQL_SA_PASSWORD=''

# Puerto local de Swagger. Usa otro si Visual Studio ya ocupa 5044.
API_PORT=5044
